    if (part.type === "capacitor") return `${displayValue(part)} nF`;
    if (part.type === "resistor") return `${(displayValue(part) / 1000).toFixed(1)} kΩ`;
    if (part.type === "switch") return settings.load;
    if (part.type === "scope") return "CH1 · CH2";
