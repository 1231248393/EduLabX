"use client";

import React, { useEffect, useMemo, useState } from "react";
import { manualPdfPath } from "@/data/adcExperiments";

type Props = { title?: string; startPage: number; endPage: number; initialPage?: number; download?: boolean };

export default function ManualPdfViewer({ title = "Original practical scan", startPage, endPage, initialPage = startPage, download = true }: Props) {
  const [page, setPage] = useState(Math.min(endPage, Math.max(startPage, initialPage)));
  const [zoom, setZoom] = useState(100);
  const [availability, setAvailability] = useState<"checking" | "available" | "missing">("checking");
  const frameSrc = useMemo(() => `${manualPdfPath}#page=${page}&zoom=${zoom}`, [page, zoom]);

  useEffect(() => {
    let active = true;
    fetch(manualPdfPath, { method: "HEAD" })
      .then((response) => { if (active) setAvailability(response.ok ? "available" : "missing"); })
      .catch(() => { if (active) setAvailability("missing"); });
    return () => { active = false; };
  }, []);

  if (availability === "checking") return <div className="rounded-xl border border-slate-200 bg-white p-6 text-sm text-slate-600">Checking for the original practical PDF…</div>;
  if (availability === "missing") return <div className="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-950"><strong>Original practical material not uploaded yet.</strong><p className="mt-1">Add the scanned PDF at <code>public/assets/adc-practicals/manual/AnyScanner_11_01_2026.pdf</code>.</p></div>;

  return <section className="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
    <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-3">
      <div><h2 className="font-bold text-slate-800">{title}</h2><p className="text-xs text-slate-500">PDF page {page} of 45 · this practical: {startPage}–{endPage}</p></div>
      <div className="flex flex-wrap items-center gap-2">
        <button type="button" onClick={() => setPage((value) => Math.max(startPage, value - 1))} disabled={page <= startPage} className="rounded border border-slate-300 px-3 py-2 text-sm disabled:opacity-40">Previous</button>
        <label className="flex items-center gap-2 text-xs font-semibold text-slate-600">Page<input aria-label="PDF page" type="number" min={startPage} max={endPage} value={page} onChange={(event) => { const next = Number(event.target.value); if (Number.isInteger(next)) setPage(Math.min(endPage, Math.max(startPage, next))); }} className="w-16 rounded border border-slate-300 px-2 py-2 text-sm text-slate-800" /></label>
        <button type="button" onClick={() => setPage((value) => Math.min(endPage, value + 1))} disabled={page >= endPage} className="rounded border border-slate-300 px-3 py-2 text-sm disabled:opacity-40">Next</button>
        <button type="button" onClick={() => setZoom((value) => Math.max(70, value - 15))} disabled={zoom <= 70} aria-label="Zoom out" className="rounded border border-slate-300 px-3 py-2 text-sm disabled:opacity-40">−</button>
        <span className="min-w-12 text-center text-xs tabular-nums text-slate-600">{zoom}%</span>
        <button type="button" onClick={() => setZoom((value) => Math.min(200, value + 15))} disabled={zoom >= 200} aria-label="Zoom in" className="rounded border border-slate-300 px-3 py-2 text-sm disabled:opacity-40">+</button>
        <a href={`${manualPdfPath}#page=${page}`} target="_blank" rel="noreferrer" className="rounded border border-[#0b5c9e] px-3 py-2 text-sm font-semibold text-[#0b5c9e] hover:bg-blue-50">Open PDF</a>
        {download && <a href={manualPdfPath} download="AnyScanner_11_01_2026.pdf" className="rounded bg-[#0b5c9e] px-3 py-2 text-sm font-semibold text-white hover:bg-blue-800">Download PDF</a>}
      </div>
    </div>
    <iframe key={frameSrc} src={frameSrc} title={`${title}, page ${page}`} className="h-[620px] w-full bg-slate-100 md:h-[780px]" />
  </section>;
}
